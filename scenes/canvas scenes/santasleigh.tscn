[sub_resource type="GDScript" id="GDScript_pp874"]
resource_name = "santasleigh"
script/source = "extends CharacterBody2D

@onready var footsteps = $AudioStreamPlayer2D
@onready var santa = $AnimatedSprite2D
const SPEED = 200.0
	
func _physics_process(delta: float) -> void:
	if velocity.x != 0 or velocity.y != 0:
		santa.play(\"hopping\")
		if not footsteps.playing:
			footsteps.play()
	else:
		santa.play(\"idle\")
		footsteps.stop()
	if velocity.x < 0: 
		santa.flip_h = true
	elif velocity.x > 0:
		santa.flip_h = false
	var direction = Input.get_vector(\"left\", \"right\",\"up\", \"down\")
	
	velocity = direction * SPEED
	
	move_and_slide()
"

